{
  "name": "agritainment-platform",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev:admin": "pnpm --filter @agritainment/admin dev:h5",
    "build:admin": "pnpm --filter @agritainment/admin build:h5",
    "build": "pnpm build:admin && pnpm build:store && pnpm build:supplier && pnpm build:user",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --exclude apps/**/e2e/**",
    "audit:typography": "node scripts/audit-typography.mjs",
    "audit:buttons": "node scripts/audit-buttons.mjs",
    "audit:interfaces": "node scripts/audit-interfaces.mjs",
    "audit:mp-styles": "node scripts/audit-mp-styles.mjs",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "mp:appid": "node scripts/set-mp-appid.mjs",
    "check:supplier-assets": "node scripts/check-supplier-assets.mjs",
    "prepare:category-images": "python scripts/prepare-product-category-images.py",
    "sync:category-images": "node scripts/sync-product-category-images.mjs",
    "dev:store": "pnpm --filter @agritainment/store dev:mp-weixin",
    "dev:user": "pnpm --filter @agritainment/user dev:mp-weixin",
    "dev:supplier": "pnpm --filter @agritainment/supplier dev:mp-weixin",
    "dev:gateway": "node scripts/serve-gateway.mjs",
    "build:user": "pnpm --filter @agritainment/user build:mp-weixin",
    "build:store": "pnpm --filter @agritainment/store build:mp-weixin",
    "build:supplier": "pnpm --filter @agritainment/supplier build:mp-weixin"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/qrcode-generator": "^1.0.6",
    "fake-indexeddb": "^6.2.5",
    "lucide-static": "^0.468.0",
    "playwright-core": "1.55.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
