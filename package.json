{
  "name": "agritainment-platform",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev:admin": "pnpm --filter @agritainment/admin dev:h5",
    "build:admin": "pnpm --filter @agritainment/admin build:h5",
    "build": "pnpm build:admin && pnpm build:store && pnpm build:supplier && pnpm build:user",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --exclude apps/**/e2e/**",
    "audit:typography": "node scripts/audit-typography.mjs",
    "audit:buttons": "node scripts/audit-buttons.mjs",
    "audit:interfaces": "node scripts/audit-interfaces.mjs",
    "audit:pages": "node scripts/audit-page-api-coverage.mjs",
    "audit:pages:strict": "node scripts/audit-page-api-coverage.mjs --strict",
    "audit:mp-styles": "node scripts/audit-mp-styles.mjs",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:mp-wxs": "node scripts/audit-mp-wxs.mjs",
    "check:mp-size": "node scripts/check-mp-bundle-size.mjs",
    "check:native-assets": "node scripts/check-native-assets.mjs",
    "compress:images": "node scripts/compress-static-images.mjs",
    "mp:appid": "node scripts/set-mp-appid.mjs",
    "mp:open": "node scripts/open-mp-devtools.mjs",
    "check:supplier-assets": "node scripts/check-supplier-assets.mjs",
    "prepare:category-images": "python scripts/prepare-product-category-images.py",
    "sync:category-images": "node scripts/sync-product-category-images.mjs",
    "dev:store": "node scripts/build-native-mp.mjs store --mode dev --watch",
    "dev:user": "node scripts/build-native-mp.mjs user --mode dev --watch",
    "dev:supplier": "node scripts/build-native-mp.mjs supplier --mode dev --watch",
    "dev:gateway": "node scripts/serve-gateway.mjs",
    "build:user": "node scripts/build-native-mp.mjs user --mode build",
    "build:store": "node scripts/build-native-mp.mjs store --mode build",
    "build:supplier": "node scripts/build-native-mp.mjs supplier --mode build",
    "e2e:mp": "node tests/mp-e2e/run.mjs",
    "backend:compile": "node scripts/backend-maven.mjs -DskipTests compile",
    "backend:test": "node scripts/backend-maven.mjs test",
    "backend:package": "node scripts/backend-maven.mjs -DskipTests package",
    "build:admin:staging": "pnpm --filter @agritainment/admin build:h5",
    "build:store:staging": "node scripts/build-native-mp.mjs store --mode build --data-mode api",
    "build:supplier:staging": "node scripts/build-native-mp.mjs supplier --mode build --data-mode api",
    "build:user:staging": "node scripts/build-native-mp.mjs user --mode build --data-mode api",
    "backend:api-audit": "node scripts/backend-api-audit.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/qrcode-generator": "^1.0.6",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "lucide-static": "^0.468.0",
    "playwright-core": "1.55.0",
    "sass": "^1.89.0",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9",
    "yaml": "2.8.1"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
