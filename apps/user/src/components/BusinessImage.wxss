.business-image {
  position: relative;
  display: block;
  overflow: hidden;
}

.business-image__img {
  display: block;
  width: 100%;
  height: 100%;
}

.business-image__placeholder {
  display: block;
  width: 100%;
  height: 100%;
  background: var(--mobile-surface-subtle);
}

.business-image__error {
  position: absolute;
  right: 4px;
  bottom: 4px;
  padding: 2px 4px;
  color: var(--color-on-brand);
  font-size: 12px;
  line-height: 1.35;
  background: var(--color-toast);
  border-radius: 2px;
}