  font-size: 13px;
}
.pv-sum .val {
  margin-left: auto;
  color: var(--mobile-price);
  font-size: 18px;
  font-weight: 800;
}
.product-detail-actions.sheet-foot {
  position: static;
  display: flex;
  margin-top: 0;
}
.product-detail-actions.sheet-foot .primary-btn {
  flex: 1;
  min-height: 46px;
}
.warnrow,
.payrow,
.address-select,
.after-sale-order {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 10px;
  padding: 11px 13px;
  border-radius: 12px;
}
.warnrow {
  border: 1.5px dashed var(--color-user-danger);
  background: var(--color-danger-soft);
  color: var(--color-user-danger);
}
.warnrow text,
.payrow text {
  display: block;
  font-size: 13.5px;
  font-weight: 800;
}
.warnrow .meta,
.payrow .meta {
  display: block;
  margin-top: 2px;
  font-size: 12px;
  opacity: 0.75;
}
.warnrow-act {
  margin-left: auto;
  height: 32px;
  flex: none;
  padding: 0 12px;
  border-radius: 16px;
  background: var(--color-user-danger);
  color: var(--color-on-brand);
  font-size: 12px;
  font-weight: 800;
  line-height: 32px;
}
.payrow {
  border: 1.5px solid var(--mobile-brand);
  background: var(--mobile-brand-soft);
}
.payrow-sel {
  margin-left: auto;
  color: var(--mobile-brand);
  font-size: 12px;
  font-weight: 800;
}
.address-select {
  justify-content: space-between;
  border: 1px solid var(--mobile-border);
  background: var(--mobile-surface-subtle);
}
.address-select > view {
  min-width: 0;
  flex: 1;
}
.address-select text,
.after-sale-order text {
  display: block;
  font-size: 13px;
  font-weight: 800;
}
.address-select .meta-text,
.after-sale-order .meta-text {
  display: block;
  margin-top: 5px;
  color: var(--mobile-muted);
  font-size: 13px;
}
.kv {
  display: grid;
  gap: 9px;
  margin-top: 12px;
  padding: 11px 13px;
  border-radius: 12px;
  background: var(--mobile-surface-subtle);
}
.kvrow {
  display: flex;
  align-items: center;
  font-size: 13px;
}
.kvrow text:first-child {
  color: var(--mobile-muted);
}
.kvrow text:last-child,
.kvrow .val {
  margin-left: auto;
  font-weight: 800;
}
.kvrow-total {
  font-weight: 800;
}
.kvrow-total .val {
  color: var(--mobile-price);
  font-size: 16px;
}
.checkout-items {
  margin-top: 8px;
}
.sheet-total {
  color: var(--mobile-muted);
  font-size: 12px;
}
.sheet-total .strong-text {
  font-size: 19px;
  color: var(--mobile-price);
}
.address-list {
  display: grid;
  gap: 9px;
}
.address-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 8px;
  padding: 9px 10px;
  border: 1px solid var(--mobile-border);
  border-radius: var(--mobile-radius-card);
  background: var(--mobile-surface);
}
.address-row text {
  display: block;
  font-size: 13px;
  font-weight: 800;
}
.address-row .meta-text {
  display: block;
  margin-top: 5px;
  color: var(--mobile-muted);
  font-size: 12px;
}
.address-actions {
  display: flex;
  max-width: 112px;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 5px;
}
.address-form input {
  display: block;
  width: 100%;
  height: 44px;
  margin-bottom: 10px;
  padding: 0 12px;
  border: 1px solid var(--mobile-border);
  border-radius: var(--mobile-radius-card);
  box-sizing: border-box;
  background: var(--mobile-surface);
  font-size: 14px;
}
.default-line {
  display: flex;
  min-height: 44px;
  align-items: center;
  justify-content: space-between;
  color: var(--mobile-muted);
  font-size: 13px;
}
.toggle {
  position: relative;
  width: 42px;
  height: 24px;
  flex: none;
  border-radius: var(--mobile-radius-card);
  background: var(--color-line);
}
.toggle > view {
  position: absolute;
  top: 3px;
  left: 3px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--color-card);
}
.toggle.on {
  background: var(--mobile-brand);
}
.toggle.on > view {
  transform: translateX(18px);
}
.ship-head {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 12px;
  border-radius: 14px;
  background: var(--mobile-surface-subtle);
}
.ship-head .business-image {
  width: 56px;
  height: 56px;
  flex: none;
  border-radius: 11px;
  -o-object-fit: cover;
     object-fit: cover;
}
.ship-head text {
  display: block;
  font-size: 13.5px;
  font-weight: 800;
}
.ship-head .meta {
  display: block;
  margin-top: 3px;
  color: var(--mobile-muted);
  font-size: 12px;
}
.ship-sup {
  margin-left: auto;
  text-align: right;
}
.ship-sup text {
  font-size: 12.5px;
}
.steps2 {
  position: relative;
  margin-top: 16px;
  padding-left: 24px;
}
.steps2::before {
  content: "";
  position: absolute;
  top: 8px;
  bottom: 14px;
  left: 7px;
  width: 2px;
  background: var(--mobile-border);
}
.step {
  position: relative;
  padding-bottom: 18px;
}
.step:last-child {
  padding-bottom: 0;
}
.step::before {
  content: "";
  position: absolute;
  top: 4px;
  left: -22px;
  width: 12px;
  height: 12px;
  border: 2px solid var(--mobile-surface);
  border-radius: 50%;
  background: var(--mobile-border);
}
.step.on::before {
  background: var(--mobile-brand);
  box-shadow: 0 0 0 3px var(--mobile-brand-soft);
}
.step text {
  display: block;
  font-size: 13.5px;
  font-weight: 800;
}
.step .meta {
  display: block;
  margin-top: 3px;
  color: var(--mobile-muted);
  font-size: 12px;
  line-height: 1.6;
}
.notecard {
  display: flex;
  gap: 6px;
  margin-top: 14px;
  padding: 10px 12px;
  border-radius: 11px;
  background: var(--mobile-surface-subtle);
  color: var(--mobile-muted);
  font-size: 12px;
  line-height: 1.7;
}
.after-sale-reason,
.after-sale-evidence {
  margin-top: 10px;
}
.after-sale-reason > text,
.after-sale-evidence > text {
  display: block;
  font-size: 13px;
  font-weight: 900;
}
.after-sale-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}
.after-sale-chips button {
  min-height: 32px;
  margin: 0;
  padding: 0 10px;
  border: 1px solid var(--mobile-border);
  border-radius: 16px;
  background: var(--mobile-surface);
  color: var(--mobile-muted);
  font-size: 13px;
}
.after-sale-chips button.active {
  border-color: var(--mobile-brand);
  background: var(--mobile-brand-soft);
  color: var(--mobile-brand-deep);
  font-weight: 800;
}
.after-sale-tip {
  display: block;
  margin-top: 12px;
  color: var(--mobile-muted);
  font-size: 12px;
}
.stock-warning {
  display: block;
  margin-top: 4px;
  color: var(--mobile-danger);
  font-size: 12px;
}
.package-sheet .empty-sheet .outline-btn {
  margin-top: 22px;
  height: 44px;
  padding: 0 34px;
  border-radius: 22px;
  color: var(--mobile-text);
}
.package-group {
  width: 100%;
  margin-bottom: 18px;
  text-align: left;
}
.package-row {
  display: flex;
  min-width: 0;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-top: 9px;
  padding: 10px;
  border: 1px solid var(--mobile-border);
  border-radius: var(--mobile-radius-card);
  background: var(--mobile-surface);
}
.package-row > view:first-child {
  min-width: 0;
  flex: 1 1 100%;
}
.package-row text {
  display: block;
  font-size: 13px;
  font-weight: 800;
}
.package-row .meta-text {
  display: block;
  margin-top: 4px;
  color: var(--mobile-muted);
  font-size: 12px;
}
.package-actions {
  display: flex;
  width: 100%;
  flex: none;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
.package-actions .strong-text {
  color: var(--mobile-price);
  font-size: 15px;
}
.package-buy-btn {
  min-height: var(--mobile-control-compact);
  margin-left: auto;
  padding: 0 11px;
}

/* Mobile readability contrast */
.supplier-name, .stock-text, .order-time {
  color: var(--mobile-muted);
}
.mall-header,
.page-heading,
.loading-state {
  padding-top: calc(12px + var(--status-bar-height));
  padding-right: 96px;
}
.auth-page {
  padding-top: calc(24px + var(--status-bar-height));
  padding-right: 96px;
}
.app-shell,
.bottom-tabs,
.sheet-mask,
.sheet {
  left: 0;
  right: 0;
  width: 100%;
  max-width: none;
  transform: none;
}
@media (max-width: 375px) {
.address-row {
    grid-template-columns: 1fr;
}
.address-actions {
    max-width: none;
    width: 100%;
    justify-content: flex-start;
}
.waiting-copy {
    width: 100%;
    flex-basis: 100%;
}
.sub-actions {
    flex-wrap: wrap;
    justify-content: flex-end;
}
}
