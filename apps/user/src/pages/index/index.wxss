.app-shell {
  width: 100%;
  min-height: 100vh;
  overflow-x: hidden;
  padding-bottom: 0;
  box-sizing: border-box;
  background: var(--mobile-bg);
  color: var(--mobile-text);
}
.c-mall,
.page-content {
  min-width: 0;
  padding-bottom: calc(var(--mobile-tab-height) + 28px + var(--mobile-bottom-safe));
}
.app-shell.has-cart-bar .c-mall,
.app-shell.has-cart-bar .page-content {
  padding-bottom: calc(var(--mobile-tab-height) + var(--mobile-action-bar-height) + 28px + var(--mobile-bottom-safe));
}
.loading-state,
.auth-page {
  min-height: 100vh;
}
.loading-state {
  display: grid;
  place-items: center;
  padding: 24px;
  color: var(--mobile-muted);
  font-size: 14px;
}
.auth-page {
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--mobile-login-grad);
}
.auth-deco {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}
.auth-deco1 {
  top: -90px;
  right: -110px;
  width: 340px;
  height: 340px;
  background: radial-gradient(circle, rgba(var(--color-on-brand-rgb), 0.12), transparent 68%);
}
.auth-deco2 {
  top: 220px;
  left: -120px;
  width: 280px;
  height: 280px;
  background: radial-gradient(circle, rgba(var(--color-on-brand-rgb), 0.08), transparent 68%);
}
.auth-brand {
  position: relative;
  padding: calc(150px + env(safe-area-inset-top)) 24px 0;
  text-align: center;
}
.auth-mark {
  display: grid;
  width: 66px;
  height: 66px;
  margin: 0 auto 16px;
  place-items: center;
  border: 1px solid rgba(var(--color-on-brand-rgb), 0.32);
  border-radius: 18px;
  background: rgba(var(--color-on-brand-rgb), 0.18);
  color: var(--color-on-brand);
}
.auth-brand-name {
  display: block;
  color: var(--color-on-brand);
  font-size: 24px;
  font-weight: 800;
  letter-spacing: 1px;
}
.auth-brand-sub {
  display: block;
  margin-top: 10px;
  color: rgba(var(--color-on-brand-rgb), 0.85);
  font-size: 13px;
}
.auth-card {
  position: relative;
  margin-top: auto;
  padding: 30px 24px 34px;
  border-radius: var(--radius-user-login) var(--radius-user-login) 0 0;
  background: var(--mobile-surface);
  box-shadow: 0 -18px 50px rgba(var(--color-user-brand-deep-rgb), 0.25);
  text-align: center;
}
.auth-wxbadge {
  display: grid;
  width: 52px;
  height: 52px;
  margin: 0 auto 14px;
  place-items: center;
  border-radius: 50%;
  background: var(--mobile-wx-soft);
  color: var(--mobile-wx);
}
.auth-btn {
  display: flex;
  width: 100%;
  min-height: 50px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin: 0;
  border: 0;
  border-radius: var(--mobile-radius-pill);
  background: var(--mobile-hero-grad);
  box-shadow: var(--mobile-shadow-button);
  color: var(--color-on-brand);
  font-size: 15.5px;
  font-weight: 800;
}
.auth-tip {
  display: block;
  margin-top: 16px;
  color: var(--mobile-muted);
  font-size: 12px;
}
.mall-header,
.page-heading {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
  padding: calc(12px + env(safe-area-inset-top)) 16px 28px;
}
.page-heading {
  display: block;
}
.theme-head {
  background: var(--mobile-hero-grad);
  color: var(--color-on-brand);
}
.theme-head::after {
  content: "";
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 22px;
  border-radius: 22px 22px 0 0;
  background: var(--mobile-bg);
}
.theme-head .page-sub,
.theme-head .eyebrow {
  color: rgba(var(--color-on-brand-rgb), 0.85);
}
.eyebrow {
  display: block;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2.5px;
}
.mall-title,
.page-title {
  display: block;
  margin-top: 3px;
  font-size: 21px;
  font-weight: 800;
  line-height: 1.25;
}
.page-sub {
  display: block;
  margin-top: 4px;
  font-size: 12px;
}
.role-chip {
  display: inline-flex;
  flex: none;
  align-items: center;
  gap: 5px;
  height: 32px;
  min-height: 44px;
  padding: 0 12px;
  border: 1px solid rgba(var(--color-on-brand-rgb), 0.28);
  border-radius: 16px;
  background: rgba(var(--color-on-brand-rgb), 0.16);
  color: var(--color-on-brand);
  font-size: 12px;
  font-weight: 700;
}
.search-box {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 42px;
  margin: 12px 16px 0;
  padding: 0 14px;
  border: 1px solid var(--mobile-border);
  border-radius: var(--mobile-radius-pill);
  background: var(--mobile-surface);
  color: var(--mobile-muted);
  box-shadow: 0 1px 2px rgba(var(--color-user-brand-deep-rgb), 0.04);
}
.search-input {
  min-width: 0;
  flex: 1;
  height: 100%;
  color: var(--mobile-text);
  font-size: 13px;
}
.package-banner {
  position: relative;
  display: flex;
  overflow: hidden;
  align-items: center;
  gap: 12px;
  margin: 12px 16px 0;
  padding: 14px 16px;
  border-radius: 16px;
  background: var(--mobile-hero-grad);
  color: var(--color-on-brand);
}
.package-banner::after {
  content: "";
  position: absolute;
  top: -70px;
  right: -50px;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--color-on-brand-rgb), 0.14), transparent 70%);
}
.package-banner > view:not(.banner-play) {
  position: relative;
  z-index: 1;
  min-width: 0;
  flex: 1;
}
.package-banner-mark {
  position: relative;
  z-index: 1;
  display: grid;
  width: 42px;
  height: 42px;
  flex: none;
  place-items: center;
  border-radius: 50%;
  background: rgba(var(--color-on-brand-rgb), 0.2);
}
.banner-kicker,
.banner-title,
.banner-sub {
  display: block;
}
.banner-kicker {
  color: rgba(var(--color-on-brand-rgb), 0.75);
  font-size: 12px;
  letter-spacing: 1px;
}
.banner-title {
  margin-top: 3px;
  font-size: 16.5px;
  font-weight: 800;
}
.banner-sub {
  margin-top: 3px;
  color: rgba(var(--color-on-brand-rgb), 0.85);
  font-size: 12px;
}
.banner-play {
  position: relative;
  z-index: 1;
  display: grid;
  width: 42px;
  height: 42px;
  flex: none;
  place-items: center;
  border: 1px solid rgba(var(--color-on-brand-rgb), 0.32);
  border-radius: 50%;
  background: rgba(var(--color-on-brand-rgb), 0.2);
  color: var(--color-on-brand);
}
.section-line {
  display: flex;
  align-items: baseline;
  margin: 16px 16px 10px;
  font-size: 15.5px;
  font-weight: 800;
}
.section-line .meta-text {
  margin-left: auto;
  color: var(--mobile-muted);
  font-size: 12px;
  font-weight: 400;
}
.waterfall-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  align-items: start;
  padding: 0 16px;
}
.product-card {
  overflow: hidden;
  border: 1px solid var(--mobile-border);
  border-radius: var(--mobile-radius-card);
  background: var(--mobile-surface);
  box-shadow: 0 1px 2px rgba(var(--color-user-brand-deep-rgb), 0.05);
}
.product-image-wrap {
  position: relative;
}
.product-image {
  display: block;
  width: 100%;
  aspect-ratio: 1/1;
  background: var(--mobile-surface-subtle);
  -o-object-fit: cover;
     object-fit: cover;
}
.product-body {
  display: flex;
  min-width: 0;
  flex-direction: column;
  padding: 9px 10px 11px;
}
.tag-row,
.pv-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  overflow: hidden;
}
.tag {
  display: inline-flex;
  height: 20px;
  align-items: center;
  padding: 0 6px;
  border-radius: 6px;
  background: var(--mobile-brand-soft);
  color: var(--mobile-brand-deep);
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}
.product-name {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 6px;
  font-size: 13.5px;
  font-weight: 800;
  line-height: 1.4;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.supplier-name,
.product-meta {
  display: block;
  overflow: hidden;
  margin-top: 4px;
  color: var(--mobile-muted);
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-foot {
  display: flex;
  min-width: 0;
  align-items: center;
  margin-top: 8px;
}
.product-price,
.pv-meta .val,
.sku-sum-price,
.commission-row .strong-text,
.cart-checkout .val {
  color: var(--mobile-price);
  font-variant-numeric: tabular-nums;
}
.product-price {
  flex: 1;
  font-size: 17px;
  font-weight: 800;
}
.product-price-box {
  display: inline-flex;
  min-width: 0;
  flex: 1;
  align-items: baseline;
  gap: 4px;
}
.product-original {
  color: var(--mobile-muted);
  font-size: 12px;
}
.product-action {
  display: inline-flex;
  width: 30px;
  min-width: 30px;
  height: 30px;
  min-height: 44px;
  flex: none;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: var(--mobile-hero-grad);
  box-shadow: var(--mobile-shadow-button);
  color: var(--color-on-brand);
}
.product-action:disabled {
  opacity: 0.45;
  transform: none;
}
.product-action .ui-icon {
  filter: brightness(0) invert(1);
}
.category-grid {
  display: flex;
  gap: 12px 2px;
  overflow-x: auto;
  padding: 12px 16px 0;
  scrollbar-width: none;
}
.category-grid::-webkit-scrollbar {
  display: none;
}
.category-grid .category-grid-item {
  min-width: 0;
  flex: none;
  padding: 0;
  background: transparent;
}
.category-grid .category-grid-img {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--mobile-surface-subtle);
}
.category-grid .category-grid-label {
  height: 30px;
  font-size: 12px;
  line-height: 1.25;
  text-align: center;
  color: var(--mobile-muted);
  word-break: keep-all;
}
.category-grid .category-grid-item.active .category-grid-img {
  box-shadow: 0 0 0 2px var(--mobile-brand);
}
.category-grid .category-grid-item.active .category-grid-label {
  color: var(--mobile-brand);
  font-weight: 800;
}
.empty-block {
  display: flex;
  min-height: 150px;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 24px;
  color: var(--mobile-muted);
  font-size: 13px;
  text-align: center;
}
.empty-block.large {
  min-height: 160px;
  flex-direction: column;
}
.empty-block.compact {
  min-height: 96px;
  flex-direction: column;
}
.empty-sheet {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 26px 0 10px;
  text-align: center;
}
.empty-sheet text {
  font-size: 14.5px;
  font-weight: 800;
  color: var(--mobile-text);
}
.empty-sheet .meta {
  color: var(--mobile-muted);
  font-size: 12px;
  line-height: 1.7;
}
.order-card {
  margin: 10px 16px 0;
  padding: 13px 14px;
  border: 1px solid var(--mobile-border);
  border-radius: 16px;
  background: var(--mobile-surface);
  box-shadow: 0 1px 2px rgba(var(--color-user-brand-deep-rgb), 0.04);
}
.order-head,
.sub-head,
.order-bottom,
.sheet-total {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.order-id-line {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 6px;
}
.order-id {
  display: block;
  min-width: 0;
  word-break: break-all;
  font-size: 12.5px;
  font-weight: 800;
}
.order-time {
  display: block;
  margin-top: 3px;
  color: var(--mobile-muted);
  font-size: 12px;
}
.order-status {
  flex: none;
  color: var(--mobile-warning);
  font-size: 12.5px;
  font-weight: 800;
}
.order-status.is-done {
  color: var(--color-success);
}
.order-status.muted {
  color: var(--mobile-muted);
}
.demo-badge,
.default-label {
  flex: none;
  padding: 0 6px;
  border-radius: 5px;
  background: var(--mobile-surface-subtle);
  color: var(--mobile-muted);
  font-size: 12px;
  font-weight: 700;
}
.sub-order {
  margin-top: 11px;
  padding: 11px 12px;
  border-radius: 12px;
  background: var(--mobile-surface-subtle);
}
.sub-head {
  font-size: 12.5px;
  font-weight: 800;
}
.sub-head text:last-child {
  margin-left: auto;
  color: var(--mobile-muted);
  font-size: 12px;
  font-weight: 700;
}
.order-item {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 9px;
  margin-top: 9px;
}
.order-item .business-image {
  width: 46px;
  height: 46px;
  flex: none;
  border-radius: 9px;
  background: var(--mobile-surface);
  -o-object-fit: cover;
     object-fit: cover;
}
.order-item > view:not(.voucher-thumb) {
  min-width: 0;
  flex: 1;
}
.order-item text,
.cart-line-main > text {
  display: block;
  color: var(--mobile-text);
  font-size: 12.5px;
  font-weight: 800;
}
.order-item .meta-text,
.cart-line-main .meta-text {
  display: block;
  margin-top: 2px;
  color: var(--mobile-muted);
  font-size: 12px;
}
.order-item > .strong-text {
  flex: none;
  color: var(--mobile-price);
  font-size: 13px;
  font-weight: 800;
}
.tracking-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 6px;
  margin-top: 9px;
  color: var(--mobile-muted);
  font-size: 12px;
}
.tracking-code {
  padding: 2px 6px;
  border: 1px solid var(--mobile-border);
  border-radius: 6px;
  background: var(--mobile-surface);
  color: var(--mobile-text);
  font-size: 12px;
  font-weight: 700;
}
.order-bottom {
  margin-top: 11px;
  padding-top: 10px;
  border-top: 1px dashed var(--mobile-border);
  color: var(--mobile-muted);
  font-size: 12px;
}
.order-bottom .strong-text {
  color: var(--mobile-price);
  font-size: 14px;
  font-weight: 800;
}
.sub-actions,
.order-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 10px;
}
.waiting-copy {
  min-width: 120px;
  flex: 1;
  margin-right: auto;
  color: var(--mobile-muted);
  font-size: 12px;
}
.payment-confirmation {
  margin-top: 10px;
  color: var(--mobile-warning);
  font-size: 12px;
  font-weight: 700;
}
.vrow {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 9px;
}
.vrow-main {
  min-width: 0;
  flex: 1;
}
.vrow-main text {
  display: block;
  font-size: 12.5px;
  font-weight: 800;
}
.voucher-thumb {
  display: grid;
  width: 40px;
  height: 40px;
  flex: none;
  place-items: center;
  border-radius: 11px;
  background: var(--mobile-brand-soft);
  color: var(--mobile-brand);
}
.primary-small,
.outline-small,
.outline-btn {
  display: inline-flex;
  min-height: 32px;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 14px;
  border-radius: 16px;
  font-size: 13px;
  font-weight: 700;
}
.primary-small {
  border: 0;
  background: var(--mobile-hero-grad);
  box-shadow: var(--mobile-shadow-button);
  color: var(--color-on-brand);
}
.outline-small,
.outline-btn {
  border: 1.5px solid var(--mobile-border);
  background: var(--mobile-surface);
  color: var(--mobile-muted);
}
.primary-btn {
  display: flex;
  width: 100%;
  min-height: 46px;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin-top: 16px;
  border: 0;
  border-radius: var(--mobile-radius-pill);
  background: var(--mobile-hero-grad);
  box-shadow: var(--mobile-shadow-button);
  color: var(--color-on-brand);
  font-size: 14.5px;
  font-weight: 800;
}

.profile-panel {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 12px 16px 0;
  padding: 14px;
  border: 1px solid var(--mobile-border);
  border-radius: 16px;
  background: var(--mobile-surface);
}
.avatar {
  display: grid;
  width: 50px;
  height: 50px;
  flex: none;
  place-items: center;
  border-radius: 50%;
  background: var(--mobile-hero-grad);
  color: var(--color-on-brand);
  font-size: 19px;
  font-weight: 800;
}
.avatar-image {
  overflow: hidden;
  background: var(--mobile-surface-subtle);
}
.avatar-image-content {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.profile-main {
  min-width: 0;
  flex: 1;
}
.profile-role {
  display: block;
  font-size: 15.5px;
  font-weight: 800;
}
.profile-id {
  display: block;
  overflow: hidden;
  margin-top: 3px;
  color: var(--mobile-muted);
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.profile-state {
  display: flex;
  height: 24px;
  align-items: center;
  padding: 0 10px;
  border-radius: 12px;
  background: var(--mobile-brand-soft);
  color: var(--mobile-brand-deep);
  font-size: 12px;
  font-weight: 800;
}
.operations-hero,
.operations-grid,
.order-entry,
.normal-summary,
.referral-panel,
.settings-list {
  margin: 10px 16px 0;
  border: 1px solid var(--mobile-border);
  border-radius: 16px;
  background: var(--mobile-surface);
}
.operations-hero {
  padding: 14px;
}
.operations-hero > text {
  display: block;
  margin-bottom: 12px;
  font-size: 13.5px;
  font-weight: 800;
}
.operations-hero > view {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px 8px;
}
.operations-hero > view > view {
  min-width: 0;
  padding: 11px 12px;
  border-radius: 12px;
  background: var(--mobile-surface-subtle);
}
.operations-hero .val,
.operations-hero .meta {
  display: block;
}
.operations-hero .val {
  color: var(--mobile-price);
  font-size: 17px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}
.operations-hero .meta {
  margin-top: 3px;
  color: var(--mobile-muted);
  font-size: 12px;
}
.operations-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  padding: 0;
  border: 0;
  background: transparent;
}
.operations-grid .pc-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 12px 4px 10px;
  border: 1px solid var(--mobile-border);
  border-radius: 14px;
  background: var(--mobile-surface);
  color: var(--mobile-text);
  font-size: 12px;
  font-weight: 700;
}
.operations-grid .pc-tile-icon {
  width: 40px;
  height: 40px;
  border-radius: 13px;
}
.operations-grid .pc-tile-label {
  display: -webkit-box;
  overflow: hidden;
  max-width: 100%;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  text-align: center;
  text-overflow: ellipsis;
  white-space: normal;
}
.pc-tile-badge {
  background: var(--mobile-badge);
}
.pc-tile--coral .pc-tile-icon {
  background: var(--color-danger-soft);
  color: var(--color-user-danger);
}
.pc-tile--blue .pc-tile-icon {
  background: var(--color-info-soft);
  color: var(--color-info-dark);
}
.pc-tile--green .pc-tile-icon {
  background: var(--color-user-brand-soft);
  color: var(--color-user-brand);
}
.pc-tile--amber .pc-tile-icon {
  background: var(--color-gold-soft);
  color: var(--color-gold-dark);
}
.order-entry,
.normal-summary,
.referral-panel {
  display: flex;
  min-height: 64px;
  align-items: center;
  gap: 10px;
  padding: 13px 14px;
  border-radius: 14px;
}
.order-entry {
  justify-content: space-between;
}
