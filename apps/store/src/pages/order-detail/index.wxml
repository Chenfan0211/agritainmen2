<view class="store-subpage order-detail-page">
  <view class="subpage-hero">
    <button class="hero-back" aria-label="返回" bindtap="goBack"><ui-icon name="arrow-left" size="{{20}}"></ui-icon></button>
    <view class="hero-copy"><text class="hero-title">订单详情</text><text class="hero-sub">订单号 {{orderId || '--'}}</text></view>
    <text wx:if="{{order}}" class="hero-status">{{displayStatus}}</text>
  </view>

  <view wx:if="{{order}}" class="page-body">
    <view wx:if="{{order.status === 'pending-payment'}}" class="detail-card payment-countdown">
      <text class="countdown-title">等待付款</text>
      <strong class="countdown-time val">{{countdownText}}</strong>
      <text class="countdown-tip">请在 15 分钟内完成支付，超时订单将自动取消并释放库存</text>
    </view>

    <view wx:elif="{{fulfillmentStatus}}" class="detail-card">
      <view class="steps">
        <view wx:for="{{purchaseSteps}}" wx:key="key" class="step {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}}"><view class="step-dot">{{item.number}}</view><small class="meta">{{item.label}}</small></view>
      </view>
    </view>

    <view class="detail-card">
      <view class="section-head"><text class="card-title">商品明细</text><text class="section-meta">{{order.items.length}} 款 · {{order.itemCount}} 件</text></view>
      <view class="order-lines">
        <view wx:for="{{order.items}}" wx:key="key" class="order-line"><business-image class="line-image" src="{{item.image}}" mode="aspectFill"></business-image><view class="line-main"><text class="line-name">{{item.name}}</text><text class="line-spec">{{item.skuName}} × {{item.quantity}}</text><text class="line-unit">{{item.priceText}} / 件</text></view><strong class="line-amount val">{{item.subtotalText}}</strong></view>
      </view>
    </view>

    <view class="detail-card amount-card">
      <view class="amount-row"><text>商品合计</text><strong class="val">{{order.amountText}}</strong></view>
      <view wx:if="{{order.saved}}" class="amount-row"><text>较零售节省</text><strong class="saving val">-{{order.savedText}}</strong></view>
      <view wx:if="{{order.remark}}" class="amount-row remark-row"><text>订单备注</text><strong class="val">{{order.remark}}</strong></view>
      <view wx:if="{{order.trackingNo}}" class="amount-row"><text>运单号</text><strong class="val">{{order.trackingNo}}</strong></view>
    </view>

    <view class="detail-card">
      <view class="section-head"><text class="card-title">订单进度</text><text class="section-meta">{{displayStatus}}</text></view>
      <view class="logistics">
        <view wx:for="{{order.logistics}}" wx:key="key" class="log-event"><view class="log-dot"></view><view><text>{{item.title}}</text><small class="meta">{{item.time}} · {{item.detail}}</small></view></view>
      </view>
    </view>

    <view wx:if="{{afterSaleStatus}}" class="after-sale-status">售后状态：{{afterSaleStatus}}</view>
  </view>
  <view wx:else class="empty-order"><ui-icon name="package" size="{{28}}"></ui-icon><text>订单不存在或已失效</text><button bindtap="goBack">返回</button></view>

  <view wx:if="{{order}}" class="order-actions">
    <button class="outline-action" bindtap="repeatOrder">再次采购</button>
    <button wx:if="{{canCancel}}" class="outline-action danger" bindtap="cancelOrder">取消订单</button>
    <button wx:if="{{canReceipt}}" class="primary-action" bindtap="confirmReceipt">确认收货</button>
    <button wx:if="{{canAfterSale}}" class="primary-action" bindtap="submitAfterSale">发起售后</button>
    <button wx:if="{{canPay}}" class="primary-action" bindtap="payOrder">去支付</button>
    <button wx:if="{{canAdvance}}" class="outline-action" bindtap="advanceOrder">推进状态（演示）</button>
  </view>
</view>
